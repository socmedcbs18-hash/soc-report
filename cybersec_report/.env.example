# Lokasi UTAMA file .env modul ini:  <project>/database/cybersec_report/.env
# (bisa juga diisi lewat sidebar aplikasi: "API Key" -> Simpan ke .env). Salin baris di bawah ke file tersebut.
# JANGAN commit file .env. Kosongkan yang tidak dipakai: provider tanpa key otomatis ditampilkan
# sebagai "Provider unavailable / API key not configured" dan tidak membuat aplikasi gagal.
VT_API_KEY=
ABUSEIPDB_API_KEY=
# Belum diimplementasikan (disiapkan untuk phase berikutnya):
OTX_API_KEY=
GREYNOISE_API_KEY=
